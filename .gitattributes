# GitHub Linguist Multi-Language Configuration
# Ensures rich polyglot distribution in GitHub repository language statistics

# Force Linguist to detect and display all languages
*.cpp linguist-language=C++ linguist-detectable=true
*.hpp linguist-language=C++ linguist-detectable=true
*.c linguist-language=C linguist-detectable=true
*.h linguist-language=C linguist-detectable=true
*.rs linguist-language=Rust linguist-detectable=true
*.cs linguist-language=C# linguist-detectable=true
*.ts linguist-language=TypeScript linguist-detectable=true
*.js linguist-language=JavaScript linguist-detectable=true
*.css linguist-language=CSS linguist-detectable=true
*.html linguist-language=HTML linguist-detectable=true
*.kt linguist-language=Kotlin linguist-detectable=true
*.java linguist-language=Java linguist-detectable=true
*.swift linguist-language=Swift linguist-detectable=true
*.sh linguist-language=Shell linguist-detectable=true
*.ps1 linguist-language=PowerShell linguist-detectable=true
CMakeLists.txt linguist-language=CMake linguist-detectable=true
Dockerfile linguist-language=Dockerfile linguist-detectable=true
Justfile linguist-language=Just linguist-detectable=true

# Ignore binary data and models from language calculation
*.bin linguist-vendored=true
*.exe linguist-vendored=true
*.dll linguist-vendored=true
*.cube linguist-vendored=true
*.mp4 linguist-vendored=true
*.gif linguist-vendored=true
*.png linguist-vendored=true
*.jpg linguist-vendored=true
*.ico linguist-vendored=true
*.param linguist-vendored=true
